SECRET_KEY=change-me-before-deploying-use-at-least-32-bytes
JWT_SECRET=change-me-too-use-at-least-32-bytes
IES_INSTANCE_DIR=instance

# Debug is off unless you explicitly enable it.
# IES_DEBUG=1

# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
# IES_SECURE_COOKIES=1

# Optional bind settings for `python run.py`
# IES_HOST=127.0.0.1
# IES_PORT=5000

# Credential throttling
# IES_AUTH_MAX_FAILURES=5
# IES_AUTH_WINDOW_SECONDS=300
# IES_AUTH_LOCKOUT_SECONDS=900
