SECRET_KEY=change-me-before-deploying-use-at-least-32-bytes
JWT_SECRET=change-me-too-use-at-least-32-bytes
AUDIT_HMAC_KEY=use-a-third-stable-secret-of-at-least-32-bytes
# Set to 1 when the app is served over HTTPS (marks the session cookie Secure).
IES_SECURE_COOKIES=0
IES_INSTANCE_DIR=instance
IES_MAX_UPLOAD_BYTES=8388608
IES_LOGIN_RATE_LIMIT=5
IES_LOGIN_RATE_WINDOW=600
IES_LOGIN_LOCKOUT_THRESHOLD=8
IES_LOGIN_LOCKOUT_SECONDS=900
# Sent only on HTTPS requests; 0 disables.
IES_HSTS_SECONDS=31536000
IES_MIN_PASSWORD_LENGTH=10
# Throttles outside the login flow; a limit of 0 disables one.
IES_REGISTER_RATE_LIMIT=5
IES_REGISTER_RATE_WINDOW=3600
IES_DECRYPT_RATE_LIMIT=30
IES_DECRYPT_RATE_WINDOW=300
IES_LINK_RATE_LIMIT=20
IES_LINK_RATE_WINDOW=300

