# Leave SECRET_KEY unset to have a random 48-byte key generated and persisted to
# $IES_INSTANCE_DIR/secret.key on first run. Set it explicitly when you need the
# same key across several processes or hosts.
# SECRET_KEY=
# JWT_SECRET defaults to SECRET_KEY.
# JWT_SECRET=
AUDIT_HMAC_KEY=use-a-stable-secret-of-at-least-32-bytes

IES_INSTANCE_DIR=instance
IES_MAX_UPLOAD_BYTES=8388608
IES_MAX_IMAGE_PIXELS=64000000

# Session cookie. Secure defaults on; set to 0 only for local HTTP development,
# because a Secure cookie is silently dropped over plain HTTP.
IES_SESSION_COOKIE_SECURE=1
IES_SESSION_COOKIE_SAMESITE=Lax
IES_SESSION_IDLE_SECONDS=1800

# Sent only on HTTPS requests. Set to 0 to suppress entirely.
IES_HSTS_SECONDS=31536000

# Login throttle and account lockout.
IES_LOGIN_RATE_LIMIT=5
IES_LOGIN_RATE_WINDOW=600
IES_LOGIN_LOCKOUT_THRESHOLD=8
IES_LOGIN_LOCKOUT_SECONDS=900

# Throttles outside the login flow. Registration is capped because it generates
# an RSA-3072 key pair; decrypt and capability links because both take a secret
# as input.
IES_REGISTER_RATE_LIMIT=5
IES_REGISTER_RATE_WINDOW=3600
IES_DECRYPT_RATE_LIMIT=30
IES_DECRYPT_RATE_WINDOW=300
IES_LINK_RATE_LIMIT=20
IES_LINK_RATE_WINDOW=300

IES_MIN_PASSWORD_LENGTH=10
