SECRET_KEY=change-me-before-deploying-use-at-least-32-bytes
JWT_SECRET=change-me-too-use-at-least-32-bytes
AUDIT_HMAC_KEY=use-a-third-stable-secret-of-at-least-32-bytes
IES_INSTANCE_DIR=instance
IES_REQUIRE_STRONG_SECRETS=true
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=true
JWT_LIFETIME_SECONDS=3600
PERMANENT_SESSION_LIFETIME_SECONDS=28800
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_LOCKOUT_SECONDS=300
DECRYPT_RATE_LIMIT_ATTEMPTS=8
DECRYPT_RATE_LIMIT_WINDOW_SECONDS=300
DECRYPT_RATE_LIMIT_LOCKOUT_SECONDS=300
REGISTER_RATE_LIMIT_ATTEMPTS=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
REGISTER_RATE_LIMIT_LOCKOUT_SECONDS=3600
MAX_IMAGE_PIXELS=20000000
MAX_VAULT_MANIFEST_BYTES=1048576
MAX_VAULT_ARCHIVE_MEMBERS=10000
